        "options": {}
      },
      "id": "notify-hmn",
      "name": "4a. HMN 대기 알림",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [930, 140],
      "continueOnFail": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\":true,\"path\":\"HMN\",\"record_id\":\"{{ $('1. 웹훅 수신').item.json.body.record_id }}\",\"status\":\"WAIT_FOR_SYNC\"}",
        "options": {}
      },
      "id": "respond-hmn",
      "name": "5a. 응답(HMN 경로)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1160, 140]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rpc/complete_wait_for_sync",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"p_record_id\":\"{{ $('1. 웹훅 수신').item.json.body.record_id }}\",\"p_decision\":\"APPROVED\",\"p_memo\":\"AUTO_APPROVED_L4_L5\"}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": {}
      },
      "id": "auto-approve",
      "name": "3b. 자동 승인 처리 (L4~L5)",
