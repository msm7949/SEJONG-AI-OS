{
  "name": "세종 OS — 새 레코드 알림 (3채널)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sejong-new-record",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Supabase 웹훅 수신",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "level_emoji",
              "name": "level_emoji",
              "value": "={{ {1: '🔴', 2: '🟠', 3: '🟡', 4: '🔵', 5: '⚪'}[$json.body.level] || '⚪' }}",
              "type": "string"
            },
            {
              "id": "discord_message",
              "name": "discord_message",
              "value": "={{ $json.body.level_label }} {{ {1: '🔴', 2: '🟠', 3: '🟡', 4: '🔵', 5: '⚪'}[$json.body.level] || '⚪' }}\n\n**{{ $json.body.title }}**\n\n> {{ $json.body.content }}\n\n📋 `{{ $json.body.record_id }}`\n🤖 AI: {{ $json.body.ai_code }} | 모드: {{ $json.body.mode }}\n🔗 [승인 페이지 열기]({{ $json.body.approve_url }})",
              "type": "string"
            },
            {
              "id": "email_subject",
              "name": "email_subject",
              "value": "=[세종 OS] 새 요청: {{ $json.body.level_label }} — {{ $json.body.title }}",
              "type": "string"
            },
            {
              "id": "email_body",
              "name": "email_body",
              "value": "=<h2>{{ $json.body.level_label }} — 새 AI 요청</h2><h3>{{ $json.body.title }}</h3><p>{{ $json.body.content }}</p><hr><ul><li>Record ID: {{ $json.body.record_id }}</li><li>AI: {{ $json.body.ai_code }}</li><li>모드: {{ $json.body.mode }}</li><li>생성: {{ $json.body.created_at }}</li></ul><p><a href=\"{{ $json.body.approve_url }}\">승인 페이지 열기</a></p>",
              "type": "string"
            },
            {
              "id": "kakao_message",
              "name": "kakao_message",
              "value": "=[세종 OS 새 요청]\n{{ $json.body.level_label }}\n{{ $json.body.title }}\nAI: {{ $json.body.ai_code }} | {{ $json.body.mode }}\n승인: {{ $json.body.approve_url }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "format-message",
      "name": "메시지 포맷",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [470, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"embeds\": [{\n    \"title\": \"🆕 새 AI 요청 — HMN 결정 필요\",\n    \"description\": {{ JSON.stringify($json.discord_message) }},\n    \"color\": {{ {1: 15548997, 2: 16744192, 3: 16776960, 4: 3447003, 5: 9807270}[$input.first().json.body.level] || 9807270 }},\n    \"footer\": { \"text\": \"세종 OS v1.6 — 절대 원칙: 모든 결정은 HMN이 한다\" },\n    \"timestamp\": \"{{ $input.first().json.body.created_at }}\"\n  }]\n}",
        "options": {}
      },
      "id": "discord-notify",
      "name": "Discord 알림",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 160]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.KAKAO_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"object_type\": \"text\",\n  \"text\": {{ JSON.stringify($json.kakao_message) }},\n  \"link\": {\n    \"web_url\": \"{{ $input.first().json.body.approve_url }}\",\n    \"mobile_web_url\": \"{{ $input.first().json.body.approve_url }}\"\n  },\n  \"button_title\": \"승인 페이지 열기\"\n}",
        "options": {}
      },
      "id": "kakao-notify",
      "name": "카카오톡 알림",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 300],
      "notes": "카카오톡 API 설정 필요. SETUP_GUIDE.md 참고."
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM_EMAIL }}",
        "toEmail": "={{ $env.NOTIFICATION_EMAIL }}",
        "subject": "={{ $json.email_subject }}",
        "emailType": "html",
        "html": "={{ $json.email_body }}",
        "options": {}
      },
      "id": "email-notify",
      "name": "이메일 알림",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [700, 440],
      "credentials": {
        "smtp": {
          "id": "SMTP_CREDENTIAL_ID",
          "name": "SMTP 설정"
        }
      }
    }
  ],
  "connections": {
    "Supabase 웹훅 수신": {
      "main": [
        [{ "node": "메시지 포맷", "type": "main", "index": 0 }]
      ]
    },
    "메시지 포맷": {
      "main": [
        [
          { "node": "Discord 알림", "type": "main", "index": 0 },
          { "node": "카카오톡 알림", "type": "main", "index": 0 },
          { "node": "이메일 알림", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    { "name": "세종OS" },
    { "name": "알림" }
  ]
}
